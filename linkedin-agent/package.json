{
  "name": "linkedin-ai-agent",
  "version": "1.5.2",
  "description": "Autonomous AI agent for LinkedIn content creation and posting",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm version patch && VERSION=$(node -p \"require('./package.json').version\") && sed \"s/{{VERSION}}/$VERSION/\" public_templates/index.html >public/index.html",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dashboard": "node src/dashboard-server.js",
    "setup": "node scripts/setup.js",
    "test-post": "node scripts/test-post.js",
    "auth": "node scripts/linkedin-auth.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "node-cron": "^3.0.3",
    "better-sqlite3": "^11.0.0",
    "winston": "^3.11.0",
    "open": "^10.0.0"
  }
}
