{
  "name": "linkedin-ai-agent",
  "version": "1.0.34",
  "description": "Autonomous AI agent for LinkedIn content creation and posting",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "encrypt-key": "node scripts/encrypt-key.js",
    "timesync": "sudo ntpdate -u pool.ntp.org",
    "build1": "npm version patch && npm run build_html && npm run build_js",
    "build": "npm run build_html && npm run build_js",
    "build_html": "VERSION=$(node -p \"require('./package.json').version\") && sed \"s/{{VERSION}}/$VERSION/\" public_templates/index.html >public/index.html",
    "build_js": "VERSION=$(node -p \"require('./package.json').version\") && sed \"s/{{VERSION}}/$VERSION/\" src_templates/index.js >src/index.js",
    "start": "npm run timesync && node src/index.js",
    "nodemon": "npm run timesync && nodemon --require ./scripts/suppress-warnings.cjs --require ./scripts/traffic-monitor.cjs src/index.js",
    "preprod": "NODE_ENV=preprod npm run start",
    "production": "NODE_ENV=production npm run start",
    "int": "npm version minor && npm run build && NODE_ENV=nonprod npm run nodemon",
    "devint": "npm version minor && npm run build && NODE_ENV=dev npm run nodemon",
    "nonprod": "NODE_ENV=nonprod npm run nodemon",
    "dev": "NODE_ENV=dev npm run nodemon",
    "dashboard": "node src/dashboard-server.js",
    "setup": "node scripts/setup.js",
    "test-post": "node scripts/test-post.js",
    "auth": "node scripts/linkedin-auth.js",
    "secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "refresh": "rm -rf ./node_modules && npm install",
    "status": "curl -s http://localhost:3001/api/status | python3 -m json.tool",
    "login": "curl -I http://localhost:3001/auth/login",
    "logout": "curl -I http://localhost:3001/auth/logout",
    "authrequired": "curl -s http://localhost:3001/api/status | node -e \"process.stdin.on('data',d=>console.log(JSON.parse(d).authRequired))\"",
    "callbackfailtest": "curl -X POST http://localhost:3001/auth/callback   -H \"Content-Type: application/json\"   -d '{\"code\":\"fake\",\"state\":\"bad\"}'",
    "valid-server": "curl -sS -i http://localhost:3001/api/status;curl -sS -i http://localhost:3001/api/__nonexistent__;curl -sS -i http://localhost:3001/api/posts; curl -sS -i http://localhost:3001/auth/status;",
    "insert_test_memnership": "psql -c \"INSERT INTO memberships (auth_provider, auth_sub, tenant_id, role) VALUES ('auth0', 'auth0|test_user_001', '53f2e104-4192-439b-abdc-70954bfa9583', 'owner') ON CONFLICT DO NOTHING;\"",
    "delete_test_memnership": "psql -c \"DELETE FROM memberships WHERE auth_sub = 'auth0|test_user_001';\"",
    "getroutes": "grep -E \"router\\.(get|post|put|patch|delete)\" src/routes/api.js",
    "lastdrop": "/bin/ls -tr /datavol/$npm_package_name/drop/*.zip|tail -1",
    "extract-l": "unzip -l \"$(/bin/ls -tr /datavol/$npm_package_name/drop/*.zip|tail -1)\"     || unzip -l /datavol/$npm_package_name/drop/\"$(/bin/ls -tr /datavol/$npm_package_name/drop/|tail -1)\"",
    "extract-o": "unzip -o \"$(/bin/ls -tr /datavol/$npm_package_name/drop/*.zip|tail -1)\" -d .. || unzip -l /datavol/$npm_package_name/drop/\"$(/bin/ls -tr /datavol/$npm_package_name/drop/|tail -1)\" -d ..",
    "extract": "unzip -o \"$(/bin/ls -tr /datavol/$npm_package_name/drop/*.zip|tail -1)\" -d .. && v=$(basename $(/bin/ls -tr /datavol/$npm_package_name/drop/*.zip | tail -1));v=${v##*-};v=${v%.zip} && mkdir -p /datavol/$npm_package_name/drop/$v && unzip -o \"$(/bin/ls -tr /datavol/$npm_package_name/drop/*.zip|tail -1)\" -d /datavol/$npm_package_name/drop/$v && npm version $v && npm run build",
    "extractit": "noyes() { read -p \"$1 yes or no (default): \" && if [[ ${REPLY,,} = y ]] || [[ ${REPLY,,} = yes ]]; then return 0; fi; return 9; }; npm run extract-l && if noyes;then echo going;fi",
    "unzip": "unzip -o \"$(/bin/ls -tr /datavol/$npm_package_name/drop/*.zip|tail -1)\" -d",
    "zipall": "zip -r /datavol/$npm_package_name/drop/source/source-all.zip ../linkedin-agent -x \"**/.git/*\" -x \"**/LinkedIn_Agent_Testing/*\" -x \"**/node_modules*\" -x \"**/*.tar.gz\" -x \"**/*.zip\" -x \"**/*.md\" -x \"**/data/*\" -x \"**/deploy/*\" -x \"node_modules/*\" -x \"scripts/*\" -x \"pgsql/*\" -x \"**/.env\" -x \"**/docs/*\" -x \"README.md\" -x \".gitignore\"",
    "ziptests": "zip -r /datavol/$npm_package_name/drop/source/testing.zip ../linkedin-agent/scripts/testing/ -x \"scripts/testing/.git/*\"",
    "zipsrc": "zip -r /datavol/$npm_package_name/drop/source/src.zip ../linkedin-agent/src/ -x \"**/*.md\" -x \"data/*\" -x \"deploy/*\" -x \"node_modules/*\" -x \"scripts/*\" -x \"pgsql/*\" -x \".env\" -x \"docs/*\" -x \"README.md\" -x \".gitignore\"",
    "qa_p1": "bash scripts/testing/test-p1.sh --all",
    "qa_p1_d": "bash scripts/testing/test-p1-design.sh --all",
    "qa_p1_a": "bash scripts/testing/test-p1-adversarial.sh --all",
    "qa_p3s1": "bash scripts/testing/test-p3-step1.sh --all",
    "qa_p3s1_d": "bash scripts/testing/test-p3-step1-design.sh --all",
    "qa_p3s1_a": "bash scripts/testing/test-p3-step1-adversarial.sh --all",
    "qa_p3s2": "bash scripts/testing/test-p3-step2.sh --all",
    "qa_p3s2_d": "bash scripts/testing/test-p3-step2-design.sh --all",
    "qa_p3s2_a": "bash scripts/testing/test-p3-step2-adversarial.sh --all",
    "qa_p3s3": "bash scripts/testing/test-p3-step3.sh --all",
    "qa_p3s3_d": "bash scripts/testing/test-p3-step3-design.sh --all",
    "qa_p3s3_a": "bash scripts/testing/test-p3-step3-adversarial.sh --all",
    "qa_p3s4": "bash scripts/testing/test-p3-step4.sh --all",
    "qa_p3s4_d": "bash scripts/testing/test-p3-step4-design.sh --all",
    "qa_p3s4_a": "bash scripts/testing/test-p3-step4-adversarial.sh --all",
    "qa_p3s5": "bash scripts/testing/test-p3-step5.sh --all",
    "qa_p3s5_d": "bash scripts/testing/test-p3-step5-design.sh --all",
    "qa_p3s5_a": "bash scripts/testing/test-p3-step5-adversarial.sh --all",
    "qa_p3s6": "bash scripts/testing/test-p3-step6.sh --all",
    "qa_p3s6_d": "bash scripts/testing/test-p3-step6-design.sh --all",
    "qa_p3s6_a": "bash scripts/testing/test-p3-step6-adversarial.sh --all",
    "qa_p3s7": "bash scripts/testing/test-p3-step7.sh --all",
    "qa_p3s7_d": "bash scripts/testing/test-p3-step7-design.sh --all",
    "qa_p3s7_a": "bash scripts/testing/test-p3-step7-adversarial.sh --all",
    "s_qa_p3s7": "bash scripts/testing/test-p3-step7.sh",
    "s_qa_p3s7_d": "bash scripts/testing/test-p3-step7-design.sh",
    "s_qa_p3s7_a": "bash scripts/testing/test-p3-step7-adversarial.sh",
    "batch_test": "bash scripts/testing/batch-run-test.sh",
    "batch-test": "bash scripts/testing/batch-run-test.sh",
    "batch_test_s7": "bash scripts/testing/batch-run-test.sh 7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "axios": "^1.7.0",
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "jose": "^6.2.2",
    "node-cron": "^3.0.3",
    "open": "^10.0.0",
    "pg": "^8.20.0",
    "rss-parser": "^3.13.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
